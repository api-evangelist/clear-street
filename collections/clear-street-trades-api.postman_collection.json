            "name": "Cancel Trade By ID",
            "description": {
              "content": "Cancel a trade either by the Clear Street assigned `trade_id`, or `client_trade_id` that was provided in the original trade. If the ID you provide is, in fact, a `client_trade_id`, you must set `is_client_trade_id` to true, and also provide the `account_id` for the original trade.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "trades",
                ":trade_id"
              ],
              "host": [
                "{{trades-trade_id-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "is_client_trade_id",
                  "value": "<boolean>",
                  "description": "True if the given trade_id is a client_trade_id"
                },
                {
                  "disabled": false,
                  "key": "account_id",
                  "value": "<integer>",
                  "description": "Provide only if `is_client_trade_id` is true. This is the account_id the trade was booked to"
