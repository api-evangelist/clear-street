          "http": {
            "method": "DELETE",
            "url": "https://api.clearstreet.io/studio/v2/v1/accounts/:account_id/orders",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account identifier"
              },
              {
                "name": "side",
