                "type": "query",
                "description": "Filter by order side (BUY or SELL)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by order type (e.g., MARKET, LIMIT)"
              },
              {
                "name": "instrument_type",
                "value": "",
                "type": "query",
                "description": "Filter by instrument type (e.g., COMMON_STOCK, OPTION)"
              },
              {
                "name": "instrument_ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated instrument IDs (UUID) or symbols (equity tickers or OSI option symbols)."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Cancel all orders for an account"
        },
